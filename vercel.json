{
  "redirects": [
    { "source": "/work", "destination": "/portfolio", "permanent": true },
    { "source": "/websites/:path*", "destination": "/portfolio", "permanent": true },
    { "source": "/aboutme", "destination": "/", "permanent": true },
    { "source": "/projects", "destination": "/portfolio", "permanent": true },
    { "source": "/projects/:slug", "destination": "/portfolio/:slug", "permanent": true },
    { "source": "/templates", "destination": "/portfolio", "permanent": true },
    { "source": "/templates/:slug", "destination": "/portfolio/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
