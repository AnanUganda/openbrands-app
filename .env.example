# Copy to .env.local for local development with `vercel dev`.
# In production these live in Vercel > Settings > Environment Variables.
# Never commit real values, and never prefix secrets with VITE_ — anything
# prefixed VITE_ is bundled into the browser build and is public.

# --- Supabase (form storage) ---
# Project URL: Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: Project Settings > API Keys. SECRET — full database access,
# bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Existing integrations (already in use) ---
NOTION_TOKEN=
NOTION_LEADS_DB_ID=
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=
